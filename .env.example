# Project Broadcast Partner Test App Configuration
# Copy to .env and fill in your values

PORT=3333

# Express session secret
SESSION_SECRET=generic-partner-example-app-session-cookie

# Your partner ID from Project Broadcast
PARTNER_ID=

# Used to sign/verify requests and webhooks
SIGNING_KEY=

# API key for Integrator API endpoints
INTEGRATION_KEY=

# API URLs
BASE_CONNECT_URL=https://pb-ui.test/integrations/
BASE_CONFIGURATION_URL=https://pb.test/integrations/
BASE_API_URL=https://pb.test/api/v1/

# Set to '0' to allow self-signed certs (local dev only)
NODE_TLS_REJECT_UNAUTHORIZED=
