<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= typeof title !== 'undefined' ? title : 'PB Partner Test App' %></title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1rem;
      line-height: 1.5;
    }
    nav {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #ddd;
    }
    nav a { margin-right: 1rem; }
    pre, code { background: #f5f5f5; padding: 0.2em 0.5em; border-radius: 3px; }
    pre { padding: 1rem; overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: 0.5rem; text-align: left; }
    th { background: #f9f9f9; }
    .error { background: #fee; border: 1px solid #fcc; padding: 0.5rem 1rem; margin: 1rem 0; border-radius: 4px; }
    .success { background: #efe; border: 1px solid #cfc; padding: 0.5rem 1rem; margin: 1rem 0; border-radius: 4px; }
    button, input[type="submit"] { padding: 0.4rem 1rem; cursor: pointer; }
    input[type="url"], input[type="text"], input[type="email"] { padding: 0.4rem; width: 300px; }
    dl { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1rem; }
    dt { font-weight: bold; }
    section { margin-bottom: 2rem; }
    h2 { margin-top: 2rem; }
    .user-card {
      padding: 1rem;
      border: 1px solid #ddd;
      border-radius: 4px;
      margin-bottom: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .user-card .actions { display: flex; gap: 0.5rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.25rem; font-weight: 500; }
    .inline-form { display: inline; }
    .btn-danger { background: #dc3545; color: white; border: none; }
    .btn-danger:hover { background: #c82333; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/admin">Admin</a>
    <a href="/admin/webhooks-received">Webhooks Received</a>
    <a href="/admin/webhooks-sent">Webhooks Sent</a>
  </nav>
