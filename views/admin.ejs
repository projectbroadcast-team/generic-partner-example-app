<%- include('partials/head', { title: 'Admin - PB Partner Test App' }) %>

<h1>Partner Admin Dashboard</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="success"><%= success %></div>
<% } %>

<% if (typeof integrator !== 'undefined' && integrator) { %>
  <section>
    <h2>Integrator Details</h2>
    <dl>
      <dt>Webhook URL</dt>
      <dd><%= integrator.webhook || 'Not configured' %></dd>
      <dt>Subscribed Events</dt>
      <dd><%= (integrator.webhookEvents || []).join(', ') || 'None' %></dd>
      <dt>User Connect Hook (legacy)</dt>
      <dd><%= integrator.userConnectHook || 'Not configured' %></dd>
      <dt>User Disconnect Hook (legacy)</dt>
      <dd><%= integrator.userDisconnectHook || 'Not configured' %></dd>
    </dl>
  </section>

  <section>
    <h2>Webhook Settings</h2>
    <form method="POST" action="/admin/webhook">
      <div class="form-group">
        <label for="webhookUrl">Webhook URL</label>
        <input type="url" id="webhookUrl" name="webhookUrl" value="<%= integrator.webhook || '' %>" placeholder="https://your-app.com/webhooks/events" style="width: 400px;">
      </div>
      <div class="form-group">
        <label>Event Types</label><br>
        <% const eventTypes = ['user-connect', 'user-disconnect', 'trackable-link-click', 'landing-page-view'] %>
        <% eventTypes.forEach(type => { %>
          <label style="display: inline-block; margin-right: 1rem;">
            <input type="checkbox" name="webhookEvents" value="<%= type %>"
              <%= (integrator.webhookEvents || []).includes(type) ? 'checked' : '' %>>
            <%= type %>
          </label>
        <% }) %>
      </div>
      <h3 style="margin-top: 1.5rem;">Legacy Hooks</h3>
      <p style="font-size: 0.9em; color: #666;">These are deprecated. Use the webhook URL above instead.</p>
      <div class="form-group">
        <label for="userConnectHook">User Connect Hook</label>
        <input type="url" id="userConnectHook" name="userConnectHook" value="<%= integrator.userConnectHook || '' %>" placeholder="https://your-app.com/hooks/connected" style="width: 400px;">
      </div>
      <div class="form-group">
        <label for="userDisconnectHook">User Disconnect Hook</label>
        <input type="url" id="userDisconnectHook" name="userDisconnectHook" value="<%= integrator.userDisconnectHook || '' %>" placeholder="https://your-app.com/hooks/disconnected" style="width: 400px;">
      </div>
      <button type="submit">Update Webhook Settings</button>
    </form>
    <form method="POST" action="/admin/webhook-test" style="margin-top: 1rem;">
      <button type="submit">Send Test Webhook</button>
    </form>
  </section>

  <section>
    <h2>Connected Users (<%= users ? users.length : 0 %>)</h2>
    <% if (users && users.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>pcuid</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (const user of users) { %>
            <tr>
              <td><code><%= user.pcuid %></code></td>
              <td>
                <form method="POST" action="/admin/users/<%= encodeURIComponent(user.pcuid) %>/disconnect" style="display: inline;" onsubmit="return confirm('Are you sure you want to disconnect this user?');">
                  <button type="submit">Disconnect</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } else { %>
      <p>No users connected yet.</p>
    <% } %>
  </section>
<% } %>

</body>
</html>
